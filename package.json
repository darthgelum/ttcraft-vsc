{
  "name": "ttcraft-vsc",
  "displayName": "TTCraft VSC",
  "description": "Edit Lua scripts on your TTCraft game tables from VS Code.",
  "version": "0.2.0",
  "publisher": "ttcraft",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/darthgelum/ttcraft-vsc.git"
  },
  "bugs": {
    "url": "https://github.com/darthgelum/ttcraft-vsc/issues"
  },
  "homepage": "https://ttcraft.net/docs/vscode",
  "keywords": [
    "ttcraft",
    "lua",
    "tabletop",
    "board game",
    "scripting"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "workspaceContains:**/.ttcraft/table.json"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ttcraft",
          "title": "TTCraft",
          "icon": "media/dice.png"
        }
      ]
    },
    "views": {
      "ttcraft": [
        {
          "id": "ttcraftTables",
          "name": "Tables"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "ttcraftTables",
        "when": "!ttcraft.signedIn",
        "contents": "Sign in to TTCraft to see the tables you can script.\n[Sign in](command:ttcraft.signIn)\n\nSet the site URL first if you are not on the default instance (Settings → TTCraft)."
      },
      {
        "view": "ttcraftTables",
        "when": "ttcraft.signedIn",
        "contents": "No tables you can script yet. You need Manage table permission in a room, and the table has to be open.\n[Refresh](command:ttcraft.refreshTables)"
      }
    ],
    "commands": [
      {
        "command": "ttcraft.signIn",
        "title": "Sign in",
        "category": "TTCraft",
        "icon": "$(sign-in)"
      },
      {
        "command": "ttcraft.signOut",
        "title": "Sign out",
        "category": "TTCraft"
      },
      {
        "command": "ttcraft.refreshTables",
        "title": "Refresh tables",
        "category": "TTCraft",
        "icon": "$(refresh)"
      },
      {
        "command": "ttcraft.openTable",
        "title": "Open table",
        "category": "TTCraft",
        "icon": "$(folder-opened)"
      },
      {
        "command": "ttcraft.switchTable",
        "title": "Switch table",
        "category": "TTCraft",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "ttcraft.closeTable",
        "title": "Close table",
        "category": "TTCraft",
        "icon": "$(close)"
      },
      {
        "command": "ttcraft.showConsole",
        "title": "Show table console",
        "category": "TTCraft",
        "icon": "$(output)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "ttcraft.openTable",
          "when": "false"
        },
        {
          "command": "ttcraft.closeTable",
          "when": "ttcraft.tableOpen"
        },
        {
          "command": "ttcraft.switchTable",
          "when": "ttcraft.signedIn"
        }
      ],
      "view/title": [
        {
          "command": "ttcraft.refreshTables",
          "when": "view == ttcraftTables",
          "group": "navigation"
        },
        {
          "command": "ttcraft.switchTable",
          "when": "view == ttcraftTables && ttcraft.signedIn",
          "group": "navigation"
        },
        {
          "command": "ttcraft.signIn",
          "when": "view == ttcraftTables && !ttcraft.signedIn",
          "group": "navigation"
        },
        {
          "command": "ttcraft.signOut",
          "when": "view == ttcraftTables && ttcraft.signedIn"
        }
      ],
      "view/item/context": [
        {
          "command": "ttcraft.openTable",
          "when": "view == ttcraftTables && viewItem == table",
          "group": "inline"
        },
        {
          "command": "ttcraft.closeTable",
          "when": "view == ttcraftTables && viewItem == table-open",
          "group": "inline"
        }
      ]
    },
    "configuration": {
      "title": "TTCraft",
      "properties": {
        "ttcraft.url": {
          "type": "string",
          "default": "https://ttcraft.net",
          "markdownDescription": "TTCraft URL"
        },
        "ttcraft.tableFolder": {
          "type": "string",
          "default": "",
          "markdownDescription": "Folder the open table's scripts are mirrored into. Empty: a folder under the extension's storage, added to the workspace on first use (VS Code restarts extensions when a window gets its first folder or goes from one folder to several). A folder **inside** an already-open workspace folder avoids that entirely. Must be empty the first time — the extension wipes its own files there on every switch."
        }
      }
    }
  },
  "scripts": {
    "icons": "node media/render-icons.js",
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "node esbuild.js --production",
    "check-types": "tsc --noEmit",
    "vscode:prepublish": "npm run check-types && node esbuild.js --production"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@types/ws": "^8.5.10",
    "esbuild": "^0.20.2",
    "typescript": "^5.4.5"
  }
}
